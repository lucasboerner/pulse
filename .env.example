# Local development overrides for `compose.yaml`. Copy this to `.env`
# (gitignored) and edit it:
#
#   cp .env.example .env
#
# Every value has a safe default in compose.yaml, so an empty `.env` — or none
# at all — also works for local development.

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=!ChangeMe!

# ── Self-hosting ────────────────────────────────────────────────────────────
# Not configured here. `install.sh` generates the secrets and writes the
# self-hosting `.env` for you — see the Quickstart in README.md. The full list
# of variables, with defaults, is the Configuration table in the same file.
