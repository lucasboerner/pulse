
###> symfony/framework-bundle ###
# Dev-only APP_SECRET. Committed on purpose: it is not a production secret (in
# production APP_SECRET is supplied as an environment variable) and a fixed value
# keeps dev caches stable across machines.
#
# The placeholder below is deliberately inert — every clone of this repo shares
# it. Give your checkout its own before you rely on anything it signs:
#
#   sed -i '' "s/^APP_SECRET=.*/APP_SECRET=$(openssl rand -hex 16)/" api/.env.dev
#
# Or put a value in api/.env.dev.local (gitignored) to keep this file untouched.
APP_SECRET=00000000000000000000000000000000
###< symfony/framework-bundle ###
