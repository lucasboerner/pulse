# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='*'
###< nelmio/cors-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Local dev: the Mailpit compose service (SMTP on 1025, inbox UI on 8025).
MAILER_DSN=smtp://mailpit:1025
###< symfony/mailer ###

###> app/mail ###
# Default From header on every mail (config/packages/mailer.yaml). No worker has a
# signed-in operator to attribute alerts to, so the sender is instance config. A
# neutral no-reply default the operator overrides; product name only, no other
# display name.
MAILER_FROM="Pulse <no-reply@localhost>"
###< app/mail ###

# Application-owned variables go in their own `###> app/<domain> ###` block, the
# same convention Flex uses for bundle recipes. Keeping them grouped and labelled
# makes it obvious which package or feature owns a variable, and stops unrelated
# settings from drifting into one flat list.
###> app/frontend ###
# Base URL of the Next.js frontend, used to build links in mail sent from
# CLI/worker contexts (no incoming request to derive it from).
APP_FRONTEND_URL=http://app.pulse.orb.local
###< app/frontend ###

###> app/retention ###
# Days of raw check_result rows to keep. The hourly rollup job folds each elapsed
# hour into check_rollup (kept indefinitely) and then deletes raw rows behind this
# window. Widening it keeps more raw detail available; it never recovers rows
# already deleted. Rollups are unaffected either way.
PULSE_RAW_RETENTION_DAYS=7
###< app/retention ###

###> app/observability ###
# Minimum level for the prod file logger (see when@prod in
# config/packages/monolog.yaml). Only the prod handler stack reads this; dev/test
# log at debug to var/log/<env>.log. info keeps the size-capped prod.log readable.
LOG_LEVEL=info
###< app/observability ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Empty on purpose. `composer dump-env prod` bakes this file into the production
# image, so a passphrase here would ship inside a public image and be used to sign
# tokens. The dev/test passphrase lives in .env.dev and .env.test (committed, but
# never baked); the self-hosting stack supplies its own JWT_PASSPHRASE through the
# environment, and an empty one means an unencrypted key on a private volume.
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

###> symfony/mercure-bundle ###
# Defaults so the console and the test kernel boot outside the compose stack; the
# containers override all three through the x-api-env anchor in the compose files.
# The hub the api/worker publish to (internal Docker name).
MERCURE_URL=http://mercure/.well-known/mercure
# The public URL the browser subscribes to (phase 5 wires the client).
MERCURE_PUBLIC_URL=http://mercure.pulse.orb.local/.well-known/mercure
# Signs the publisher JWT; matches the hub keys. Committed dev value, not a real
# secret — same as APP_SECRET in .env.dev.
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
###< symfony/mercure-bundle ###
