# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# The suite never reaches a mail transport: messages are collected in memory and
# asserted (Symfony's mailer assertions), the null transport discards them, and
# MAILER_FROM is inherited from .env so the default From header still resolves.
MAILER_DSN=null://null

# The JWT keypair (config/jwt, gitignored) is encrypted with this passphrase, and
# tests/bootstrap.php mints a throwaway pair with it on a fresh checkout. Set here
# rather than in .env so it is never baked into the production image.
JWT_PASSPHRASE=d25af28d15ad046de2aee452db4a85bd95a1fabf3847a1a3df09c40c422d92cc
